# @id          text_tools
# @name        Текстовые инструменты
# @version     2.0
# @author      Ngram
# @about       Автозамены при отправке (-> в →) и команды .upper, .lower, .mock
# @needs       менять текст сообщения перед отправкой

"""Событие ``message.sending`` и команды.

Обработчик события получает сообщение, которое вот-вот уйдёт: его текст можно поменять,
а отправку — отменить, вызвав ``msg.cancel()``.
"""

from ngram import plugin, kit

DEFAULT_PAIRS = "-> = →\n<- = ←\n(c) = ©\n(tm) = ™\n... = …"

plugin.settings.define(
    kit.Section("Автозамены"),
    kit.Switch("enabled", "Заменять при отправке", default=True),
    kit.Text("pairs", "Пары замен", default=DEFAULT_PAIRS, multiline=True, limit=2000),
    kit.Note("По одной паре в строке: «что = на что»."),
)


def pairs():
    found = []
    for line in str(plugin.settings["pairs"]).splitlines():
        left, sep, right = line.partition("=")
        if sep and left.strip():
            found.append((left.strip(), right.strip()))
    return found


@plugin.on("message.sending")
def replace(msg):
    if not plugin.settings["enabled"] or not msg.text:
        return
    text = msg.text
    for old, new in pairs():
        text = text.replace(old, new)
    if text != msg.text:
        msg.text = text


@plugin.command(".upper", help="отправить заглавными")
def upper(cmd):
    return cmd.args.upper() or None


@plugin.command(".lower", help="отправить строчными")
def lower(cmd):
    return cmd.args.lower() or None


@plugin.command(".mock", help="оТпРаВиТь ВоТ тАк")
def mock(cmd):
    return "".join(ch.upper() if i % 2 else ch.lower() for i, ch in enumerate(cmd.args)) or None
