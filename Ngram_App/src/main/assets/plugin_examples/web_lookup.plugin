# @id          web_lookup
# @name        Справка из сети
# @version     2.0
# @author      Ngram
# @about       Команда .wiki — короткая справка из Википедии прямо в поле отправки
# @needs       интернет (ru.wikipedia.org); отправлять сообщение, когда вы пишете команду

"""Сеть: запрос в фоне и ответ в чат.

Обработчик команды ничего не возвращает — значит, сама команда не отправляется. Ответ из сети
приходит позже, и плагин отправляет его сам через ``chats.send``.
"""

from urllib.parse import quote

from ngram import plugin, ui, chats, net, kit

plugin.settings.define(
    kit.Section("Справка из сети"),
    kit.Choice("lang", "Язык Википедии", ["Русский", "English"], default=0),
    kit.Switch("preview", "Сначала показать, потом отправлять", default=True),
    kit.Note("Напишите «.wiki Байкал» и отправьте."),
)


@plugin.command(".wiki", help="короткая справка из Википедии")
def wiki(cmd):
    if not cmd.args:
        ui.toast("Напишите, что искать: .wiki Байкал", kind="error")
        return
    chat_id = cmd.chat_id
    host = ("ru", "en")[plugin.settings["lang"]] + ".wikipedia.org"

    def answered(response, error):
        if error is not None or not response.ok:
            ui.toast("Не нашлось: %s" % cmd.args, kind="error")
            return
        data = response.json()
        text = "**%s**\n%s" % (data.get("title", cmd.args), data.get("extract", ""))
        if plugin.settings["preview"]:
            ui.alert(data.get("title", cmd.args), data.get("extract", ""), ok="Отправить", cancel="Закрыть",
                     on_ok=lambda: chats.send(chat_id, text))
        else:
            chats.send(chat_id, text)

    net.get("https://%s/api/rest_v1/page/summary/%s" % (host, quote(cmd.args.replace(" ", "_"))), then=answered)
